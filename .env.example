# Optional GitHub token raises the GitHub REST API limit. Keep the value private.
GITHUB_TOKEN=
# Local Ollama endpoint/model; AI remains disabled unless a model is configured and enabled in UI.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Ollama inference timeout, independent of GitHub request timeout.
OLLAMA_TIMEOUT_SECONDS=60
# PR descriptions shorter than this many characters receive a low-severity signal.
MIN_DESCRIPTION_CHARS=20
REQUEST_TIMEOUT_SECONDS=15
MAX_PULL_REQUESTS=30
MAX_CHANGED_FILES=100
LOG_LEVEL=INFO
# Deployment controls. Set PRISM_DEV=1 only for local development.
HOST=0.0.0.0
PORT=8000
PRISM_DEV=0
PRISM_DIST_DIR=dist
PRISM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8443,http://127.0.0.1:8443
PRISM_TRUST_PROXY=0
PRISM_RATE_LIMIT_REQUESTS=20
PRISM_RATE_LIMIT_WINDOW_SECONDS=600
PRISM_MAX_REQUEST_BYTES=1000000
PRISM_MAX_COMPARISON_PRS=10
# Comma-separated fnmatch patterns excluded from overlap signals; defaults documented in Settings.
PRISM_OVERLAP_IGNORED_PATHS=
PRISM_GITHUB_CACHE_TTL_SECONDS=300
PRISM_GITHUB_CACHE_MAX_ITEMS=256
# Optional external dashboard origin. Leave blank to use the local /dashboard route.
VITE_DASHBOARD_URL=
